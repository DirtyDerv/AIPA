# AIPA Project - Git Ignore File
# IMPORTANT: Never commit sensitive credentials!

# Environment variables and secrets
.env
.env.local
.env.*.local
*.key
*.pem

# API Keys and tokens
*_token.json
*_credentials.json
gmail_token.json
gmail_credentials.json

# Database credentials
database.ini
db_config.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# n8n
.n8n/
n8n-local/

# MCP Server state
.mcp/
mcp-state/

# Temporary files
tmp/
temp/
*.tmp

# OS files
Thumbs.db
.DS_Store

# Backup files
*.bak
backup/
backups/

# Database dumps (may contain sensitive data)
*.sql
*.dump

# Local configuration
config.local.json
settings.local.json

# Test outputs
test-results/
coverage/

# AI model caches
.cache/
models/
*.model

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# Keep directory structure but ignore contents
**/logs/*
!**/logs/.gitkeep

# Exceptions - DO commit these
!.env.example
!database/schema*.sql
!requirements.txt
