      "id": "gmail-trigger",
      "name": "Gmail Trigger - Check New Emails",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "1",
          "name": "Gmail"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "// Extract email data\nconst email = items[0].json;\n\nreturn [{\n  json: {\n    email_id: email.id,\n    thread_id: email.threadId,\n    from: email.payload.headers.find(h => h.name === 'From')?.value || '',\n    to: email.payload.headers.find(h => h.name === 'To')?.value || '',\n    subject: email.payload.headers.find(h => h.name === 'Subject')?.value || '',\n    date: email.payload.headers.find(h => h.name === 'Date')?.value || '',\n    body: email.snippet || '',\n    labels: email.labelIds || [],\n    full_email: email\n  }\n}];"
      },
      "id": "parse-email",
      "name": "Parse Email Data",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "none",
        "requestMethod": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro:generateContent?key=AIzaSyBBo5QRTxtMrxIkMrg4_1ULfKHNIZr3zdE",
        "options": {},
        "headerParametersJson": "={\n  \"Content-Type\": \"application/json\"\n}",
        "bodyParametersJson": "={\n  \"generationConfig\": {\"temperature\": 0.7, \"maxOutputTokens\": 2048},\n  \"maxOutputTokens\": 1024,\n  \"contents\": [\n    {\n      \"parts\": [{\"text\": \"Analyze this email and classify it. Return ONLY a JSON object with no markdown formatting.\\n\\nEmail:\\nFrom: {{ $json.from }}\\nSubject: {{ $json.subject }}\\nBody: {{ $json.body }}\\n\\nClassify into:\\n1. business_context: 'woodys_creations', 'dj_business', 'bmf_work', 'pub', 'personal', 'unknown'\\n2. category: 'order', 'inquiry', 'booking', 'invoice', 'support', 'marketing', 'personal', 'spam'\\n3. priority: 'urgent', 'high', 'medium', 'low'\\n4. sentiment: 'positive', 'neutral', 'negative'\\n5. requires_response: true or false\\n6. summary: brief 1-sentence summary\\n7. suggested_action: what to do next\\n\\nReturn JSON only:\"\n    }\n  ]\n}"
      },
      "id": "ai-classify-email",
      "name": "AI Classify Email (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "// Extract Claude's classification from response\nconst response = items[0].json.candidates[0].content.parts[0].text;\n\n// Parse the JSON response\nlet classification;\ntry {\n  // Remove markdown code blocks if present\n  const cleanResponse = response.replace(/```json\\n?|```\\n?/g, '').trim();\n  classification = JSON.parse(cleanResponse);\n} catch (e) {\n  // Fallback classification\n  classification = {\n    business_context: 'unknown',\n    category: 'inquiry',\n    priority: 'medium',\n    sentiment: 'neutral',\n    requires_response: true,\n    summary: 'Email classification failed',\n    suggested_action: 'Manual review needed'\n  };\n}\n\n// Merge with original email data\nconst emailData = $node[\"Parse Email Data\"].json;\n\nreturn [{\n  json: {\n    ...emailData,\n    ai_classification: classification,\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "parse-ai-response",
      "name": "Parse AI Classification",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.ai_classification.business_context }}",
              "operation": "equals",
              "value2": "woodys_creations"
            }
          ]
        }
      },
