        "options": {},
        "headerParametersJson": "={\n  \"Content-Type\": \"application/json\"\n}",
        "bodyParametersJson": "={\n  \"generationConfig\": {\"temperature\": 0.7, \"maxOutputTokens\": 2048},\n  \"maxOutputTokens\": 2048,\n  \"contents\": [\n    {\n      \"parts\": [{\"text\": \"Draft a professional email response for this email:\\n\\nOriginal Email:\\nFrom: {{ $json.from }}\\nSubject: {{ $json.subject }}\\nBody: {{ $json.body }}\\n\\nBusiness Context: {{ $json.ai_classification.business_context }}\\nCategory: {{ $json.ai_classification.category }}\\n\\nWrite a professional, friendly response. Sign it from Woody. Return ONLY the email body text, no subject line.\"\n    }\n  ]\n}"
      },
      "id": "generate-response",
      "name": "Generate Draft Response (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        1850,
        250
      ]
    },
    {
      "parameters": {
        "functionCode": "// Extract draft response\nconst response = items[0].json.candidates[0].content.parts[0].text;\nconst emailData = $node[\"Check if Needs Response\"].json;\n\nreturn [{\n  json: {\n    ...emailData,\n    draft_response: response,\n    draft_created_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "parse-draft",
      "name": "Parse Draft Response",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        2050,
