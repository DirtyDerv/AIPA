        "operation": "create",
        "message": "={{ $json.draft_response }}",
        "subject": "=Re: {{ $json.subject }}",
        "toList": "={{ $json.from }}",
        "options": {
          "threadId": "={{ $json.thread_id }}"
        }
      },
