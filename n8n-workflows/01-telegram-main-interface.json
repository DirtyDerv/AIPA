    {
      "parameters": {
        "functionCode": "// Log conversation to database\nconst chatId = items[0].json.message.chat.id;\nconst userId = items[0].json.message.from.id;\nconst username = items[0].json.message.from.username || items[0].json.message.from.first_name;\nconst messageText = items[0].json.message.text;\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    user_id: userId,\n    username: username,\n    message: messageText,\n    timestamp: new Date().toISOString(),\n    message_type: 'command'\n  }\n}];"
      },
      "id": "log-conversation",
      "name": "Log Conversation",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "conversations",
        "columns": "chat_id, user_id, username, message, timestamp, message_type",
        "additionalFields": {}
      },
