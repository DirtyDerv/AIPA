      "id": "89f8f7c8-8f3b-413b-8ec0-8427f99e6df4",
      "name": "Telegram Trigger",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "AIPA Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract relevant data from Telegram message\nconst message = $input.first().json.message;\n\nreturn [{\n  json: {\n    telegram_id: message.from.id,\n    telegram_username: message.from.username || '',\n    first_name: message.from.first_name || '',\n    chat_id: message.chat.id,\n    message_text: message.text || '',\n    message_type: message.text?.startsWith('/') ? 'command' : 'text',\n    command: message.text?.startsWith('/') ? message.text.split(' ')[0].substring(1) : null,\n    command_args: message.text?.startsWith('/') ? message.text.split(' ').slice(1).join(' ') : null,\n    timestamp: new Date(message.date * 1000).toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        300
      ],
      "id": "extract-message",
      "name": "Extract Message Info"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  id,\n  telegram_id,\n  first_name,\n  role,\n  allowed_contexts,\n  is_active\nFROM users\nWHERE telegram_id = {{ $json.telegram_id }}\nAND is_active = true\nLIMIT 1;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        580,
        300
      ],
      "id": "check-user",
      "name": "Check User Exists",
      "credentials": {
