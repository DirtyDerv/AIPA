    {
      "parameters": {
        "jsCode": "const userMessage = $('Extract Message Info').item.json.message_text;\nconst userName = $('Extract Message Info').item.json.first_name;\nconst chatId = $('Extract Message Info').item.json.chat_id;\n\n// Prepare AI request\nreturn [{\n  json: {\n    chat_id: chatId,\n    user_message: userMessage,\n    user_name: userName,\n    system_prompt: `You are ${userName}'s Executive Assistant AI for managing multiple businesses: Woody's Creations (laser gifts), DJ Business, BMF Work, and personal life. Respond helpfully and concisely to: \"${userMessage}\". Keep responses under 500 characters for Telegram.`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        280
      ],
      "id": "prepare-ai",
      "name": "Prepare AI Request"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-3-5-sonnet-20241022"
            },
            {
              "name": "max_tokens",
              "value": "1024"
            },
            {
              "name": "system",
              "value": "={{ $json.system_prompt }}"
            },
            {
              "name": "messages",
              "value": "=[{\"role\": \"user\", \"content\": \"{{ $json.user_message }}\"}]"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        280
      ],
      "id": "claude-api",
      "name": "Call Claude API",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CLAUDE_CREDENTIAL_ID",
          "name": "Claude API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst chatId = $('Prepare AI Request').item.json.chat_id;\nconst aiMessage = response.content[0].text;\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    text: aiMessage\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        280
      ],
